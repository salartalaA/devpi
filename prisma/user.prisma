model User {
    id String @id @default(cuid())

    fullName String
    username String @unique

    avatarURL String?
    bio       String?

    email    String @unique
    password String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    sessions Session[]
}

model Session {
    id String @id

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    expiresAt DateTime

    createdAt DateTime @default(now())
}
